rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function firmado() {
      return request.auth != null;
    }

    function perfilExiste() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function tieneRol(permitidos) {
      return firmado() && perfilExiste() && (rol() in permitidos);
    }

    // Usuarios: cada usuario lee su propio perfil; solo admin lista, crea y modifica.
    // El primer administrador se crea manualmente desde la consola.
    match /usuarios/{uid} {
      allow get: if firmado() && (request.auth.uid == uid || tieneRol(['admin']));
      allow list: if tieneRol(['admin']);
      allow create, update: if tieneRol(['admin']);
      allow delete: if false;
    }

    // Personas: lectura para usuarios registrados; escritura solo admin y registro.
    // `nombreBusqueda` y `ci` los mantiene el sistema.
    // El borrado físico es solo para mantenimiento con rol admin
    // (p. ej. regenerar datos de prueba); la app desactiva, no elimina.
    match /personas/{id} {
      allow read: if firmado() && perfilExiste();
      allow create: if tieneRol(['admin', 'registro'])
        && request.resource.data.ci is string;
      allow update: if tieneRol(['admin', 'registro']);
      allow delete: if tieneRol(['admin']);
    }

    // Aportes: nunca se editan; solo se crean (vigentes) o se anulan con
    // motivo. El número de recibo lo asigna la transacción. La app jamás
    // elimina aportes (§17): el borrado físico queda reservado a
    // mantenimiento con rol admin (p. ej. regenerar datos de prueba).
    match /aportes/{id} {
      allow read: if firmado() && perfilExiste();
      allow create: if tieneRol(['admin', 'registro'])
        && request.resource.data.estado == 'vigente'
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.personaId is string
        && request.resource.data.numeroRecibo is string
        && request.resource.data.usuarioRegistroId == request.auth.uid;
      allow update: if tieneRol(['admin', 'registro'])
        && resource.data.estado == 'vigente'
        && request.resource.data.estado == 'anulado'
        && request.resource.data.motivoAnulacion is string
        && request.resource.data.motivoAnulacion.size() >= 3
        && request.resource.data.usuarioAnulacionId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['estado', 'motivoAnulacion', 'usuarioAnulacionId', 'fechaAnulacion', 'updatedAt']);
      allow delete: if tieneRol(['admin']);
    }

    // Reserva de CI únicos: la crea la transacción de personas; nunca se
    // modifica ni reutiliza (el borrado admin es solo para mantenimiento).
    match /personaCi/{ci} {
      allow read: if firmado() && perfilExiste();
      allow create: if tieneRol(['admin', 'registro']);
      allow update: if false;
      allow delete: if tieneRol(['admin']);
    }

    // Cierres mensuales: lectura para usuarios registrados; solo admin
    // cierra, reabre o recalcula. Las transacciones de aportes actualizan
    // el acumulador (admin/registro).
    match /cierres/{id} {
      allow read: if firmado() && perfilExiste();
      allow create, update: if tieneRol(['admin', 'registro']);
      allow delete: if tieneRol(['admin']);
    }

    // Contador del correlativo de recibos: solo lo mueve la transacción.
    // El borrado admin es solo para mantenimiento (reiniciar pruebas).
    match /contadores/{id} {
      allow read: if firmado() && perfilExiste();
      allow write: if tieneRol(['admin', 'registro']);
      allow delete: if tieneRol(['admin']);
    }

    // Auditoría: cualquiera registrado puede escribir eventos; solo admin lee.
    // Nunca se modifica; el borrado admin es solo para mantenimiento.
    match /auditoria/{id} {
      allow read: if tieneRol(['admin']);
      allow create: if firmado() && perfilExiste()
        && request.resource.data.usuarioId == request.auth.uid;
      allow update: if false;
      allow delete: if tieneRol(['admin']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
